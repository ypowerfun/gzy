# GameZoney — configuração do site (fica em /etc/gamezoney-site.env no VPS; NÃO enviar para o Git).
# Depois de mudar: sudo systemctl restart gamezoney-site
PORT=8080
SITE_URL=https://gamezoney.com
DATA_DIR=/var/lib/gamezoney-site
DOWNLOADS_DIR=/var/lib/gamezoney-site/downloads
LICENSE_PRIVATE_KEY_FILE=/var/lib/gamezoney-site/license-private.pem

# Seu e-mail (o mesmo da sua conta no site) para acessar https://gamezoney.com/admin — vários separados por vírgula
ADMIN_EMAILS=

# Preço (centavos) e texto da promoção
PRICE_CENTS=8990
PRICE_LABEL=Preço de Black Friday
# Preço "de" riscado (0 = não mostra), ex.: 19990
LIST_PRICE_CENTS=0

# Contatos do suporte (aparecem em Minha conta > Suporte)
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=

# PIX automático: Mercado Pago > Suas integrações > Credenciais de PRODUÇÃO > Access Token (APP_USR-...)
MP_ACCESS_TOKEN=
# Sem Mercado Pago: PIX manual com esta chave (você confirma o pagamento em /admin)
PIX_KEY=

# Login com Google: Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail (boas-vindas, chave da licença, esqueci a senha, respostas do suporte). Ex. HostGator: mail.gamezoney.com porta 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GameZoney <contato@gamezoney.com>
